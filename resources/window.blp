using Gtk 4.0;
using Adw 1;

template $RtvWindow : Adw.ApplicationWindow {
  title: _("RTV");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 300;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView main_view {

      /* First-run state: no source configured yet — browsing is locked. */
      Adw.NavigationPage welcome_page {
        title: _("RTV");
        can-pop: false;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage welcome_status {
            icon-name: "io.github.tunix.rtv";
            title: _("Welcome to RTV");
            description: _("Add an IPTV source — an Xtream Codes account or an M3U playlist — to start watching live TV.");

            child: Gtk.Button add_source_button {
              label: _("Add source…");
              action-name: "win.add-source";
              halign: center;
              styles ["suggested-action", "pill"]
            };
          };
        };
      }

      /* Main browse state: source picker + nested categories + favorites. */
      Adw.NavigationPage browse_page {
        title: _("RTV");
        can-pop: false;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {
            title-widget: Gtk.Box dropdown_box {
              spacing: 6;
            };

            [end]
            Gtk.MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: Adw.NavigationSplitView {
            min-sidebar-width: 280;

            sidebar: Adw.NavigationPage {
              title: _("Content");

              child: Gtk.Box {
                orientation: vertical;
                margin-start: 6;
                margin-end: 6;
                margin-bottom: 6;

                Gtk.SearchEntry search_entry {
                  margin-top: 6;
                  margin-start: 6;
                  margin-end: 6;
                  placeholder-text: _("Search content…");
                }

                Gtk.Label favorites_title {
                  label: _("Favorites");
                  xalign: 0;
                  margin-start: 10;
                  margin-top: 8;
                  visible: false;
                  styles ["caption", "dim-label"]
                }

                Gtk.ListBox favorites_list {
                  styles ["navigation-sidebar"]
                  visible: false;
                }

                Gtk.ScrolledWindow {
                  vexpand: true;
                  hscrollbar-policy: never;

                  child: Gtk.ListBox content_list {
                    styles ["navigation-sidebar"]

                    Gtk.ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Gtk.Box {
                        spacing: 6;

                        Gtk.Image {
                          icon-name: "chevron-down-symbolic";
                          pixel-size: 14;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Live");
                          xalign: 0;
                          styles ["caption", "dim-label"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "News 24";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "National Geo HD";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Discovery";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Gtk.Box {
                        spacing: 6;

                        Gtk.Image {
                          icon-name: "chevron-down-symbolic";
                          pixel-size: 14;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Sports");
                          xalign: 0;
                          styles ["caption", "dim-label"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Sports HD";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Bein Sports 1";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Gtk.Box {
                        spacing: 6;

                        Gtk.Image {
                          icon-name: "chevron-down-symbolic";
                          pixel-size: 14;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Movies");
                          xalign: 0;
                          styles ["caption", "dim-label"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Cinema One";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Action Movies";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }
                  };
                }
              };
            };

            content: Adw.NavigationPage {
              title: _("RTV");

              child: Gtk.Stack content_stack {
                transition-type: crossfade;
                transition-duration: 250;

                Gtk.StackPage {
                  name: "empty";
                  child: Adw.StatusPage {
                    icon-name: "video-display-symbolic";
                    title: _("Pick a category");
                    description: _("Choose a category from the sidebar to browse its content here.");
                  };
                }

                Gtk.StackPage {
                  name: "grid";
                  child: Gtk.ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                      maximum-size: 1000;

                      child: Gtk.FlowBox content_grid {
                        margin-top: 12;
                        margin-start: 12;
                        margin-end: 12;
                        margin-bottom: 12;
                        column-spacing: 12;
                        row-spacing: 12;
                        min-children-per-line: 3;
                        max-children-per-line: 5;
                        activate-on-single-click: true;
                        selection-mode: none;
                        valign: start;
                      };
                    };
                  };
                }
              };
            };
          };
        };
      }

      /* Full-window player: back button returns to browsing. */
      Adw.NavigationPage player_page {
        title: _("RTV");
        can-pop: true;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar player_headerbar {
            [end]
            Gtk.Button player_heart {
              icon-name: "rtv-heart-symbolic";
              tooltip-text: _("Toggle favorite");
              styles ["flat", "heart-btn"]
            }
          }

          content: Gtk.Box player_content {
            orientation: vertical;
            spacing: 12;
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 12;

            Gtk.Overlay {
              vexpand: true;

              child: Gtk.Box player_box {
                styles ["player"]
                vexpand: true;
              };

              [overlay]
              Gtk.Image app_watermark {
                icon-name: "io.github.tunix.rtv";
                pixel-size: 240;
                halign: center;
                valign: center;
                opacity: 0.15;
              }

              [overlay]
              Gtk.Revealer controls_revealer {
                halign: center;
                valign: end;
                margin-bottom: 12;
                transition-type: crossfade;
                transition-duration: 350;
                reveal-child: true;

                child: Gtk.Box controls {
                  spacing: 6;
                  styles ["controls"]

                  Gtk.Button seek_back {
                    icon-name: "media-seek-backward-symbolic";
                    tooltip-text: _("Back 10 seconds");
                    styles ["flat"]
                  }

                  Gtk.Button play_button_small {
                    icon-name: "media-playback-start-symbolic";
                    tooltip-text: _("Play / Pause");
                    styles ["flat"]
                  }

                  Gtk.Button seek_forward {
                    icon-name: "media-seek-forward-symbolic";
                    tooltip-text: _("Forward 10 seconds");
                    styles ["flat"]
                  }

                  Gtk.Button mute_button {
                    icon-name: "audio-volume-high-symbolic";
                    tooltip-text: _("Mute / Unmute");
                    styles ["flat"]
                  }

                  Gtk.Scale volume_scale {
                    orientation: horizontal;
                    width-request: 100;
                    draw-value: false;
                    valign: center;
                    adjustment: Gtk.Adjustment {
                      lower: 0.0;
                      upper: 1.0;
                      value: 0.7;
                      step-increment: 0.05;
                      page-increment: 0.1;
                    };
                  }

                  Gtk.Button fullscreen_button {
                    icon-name: "view-fullscreen-symbolic";
                    tooltip-text: _("Fullscreen");
                    styles ["flat"]
                  }
                };
              }

              [overlay]
              Gtk.Label live_badge {
                label: "LIVE";
                halign: end;
                valign: start;
                margin-end: 8;
                margin-top: 8;
                styles ["caption", "dim-label"]
              }
            }

            Gtk.Box content_info_row {
              spacing: 12;

              Gtk.Label content_title {
                styles ["title-3"]
                label: _("Select content");
                halign: start;
                hexpand: true;
                ellipsize: end;
              }

              Gtk.Label content_status {
                styles ["dim-label"]
                label: "—";
                valign: center;
              }
            }
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Add source…");
      action: "win.add-source";
    }
    item {
      label: _("Reset mock state");
      action: "win.reset-mock";
    }
  }
  section {
    item {
      label: _("_About RTV");
      action: "win.about";
    }
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
