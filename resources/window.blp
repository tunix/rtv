using Gtk 4.0;
using Adw 1;

template $RtvWindow : Adw.ApplicationWindow {
  title: _("RTV");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 300;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView main_view {

      /* First-run state: no source configured yet — browsing is locked. */
      Adw.NavigationPage welcome_page {
        title: _("RTV");
        can-pop: false;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage welcome_status {
            icon-name: "io.github.tunix.rtv";
            title: _("Welcome to RTV");
            description: _("Add an IPTV source — an Xtream Codes account or an M3U playlist — to start watching live TV.");

            child: Gtk.Button add_source_button {
              label: _("Add source…");
              action-name: "win.add-source";
              halign: center;
              styles ["suggested-action", "pill"]
            };
          };
        };
      }

      /* Main browse state: source picker + nested categories + favorites. */
      Adw.NavigationPage browse_page {
        title: _("RTV");
        can-pop: false;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {
            title-widget: Gtk.Box dropdown_box {
              spacing: 6;
            };

            [end]
            Gtk.MenuButton menu_button {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: Adw.NavigationSplitView {
            min-sidebar-width: 280;

            sidebar: Adw.NavigationPage {
              title: _("Content");

              child: Gtk.Box {
                orientation: vertical;
                margin-start: 6;
                margin-end: 6;
                margin-bottom: 6;

                Gtk.SearchEntry search_entry {
                  margin-top: 6;
                  margin-start: 6;
                  margin-end: 6;
                  placeholder-text: _("Search content…");
                }

                Gtk.ScrolledWindow {
                  vexpand: true;
                  hscrollbar-policy: never;

                  child: Gtk.ListBox content_list {
                    activate-on-single-click: true;
                    styles ["navigation-sidebar"]
                  };
                }
              };
            };

            content: Adw.NavigationPage {
              title: _("RTV");

              child: Gtk.Stack content_stack {
                transition-type: crossfade;
                transition-duration: 250;

                Gtk.StackPage {
                  name: "empty";
                  child: Adw.StatusPage {
                    icon-name: "video-display-symbolic";
                    title: _("Pick a category");
                    description: _("Choose a category from the sidebar to browse its content here.");
                  };
                }

                Gtk.StackPage {
                  name: "grid";
                  child: Gtk.ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                      maximum-size: 1000;

                      child: Gtk.FlowBox content_grid {
                        margin-top: 12;
                        margin-start: 12;
                        margin-end: 12;
                        margin-bottom: 12;
                        column-spacing: 12;
                        row-spacing: 12;
                        min-children-per-line: 3;
                        max-children-per-line: 5;
                        activate-on-single-click: true;
                        selection-mode: none;
                        valign: start;
                      };
                    };
                  };
                }

                Gtk.StackPage {
                  name: "search";
                  child: Gtk.ScrolledWindow {
                    hscrollbar-policy: never;

                    child: Adw.Clamp {
                      maximum-size: 1000;

                      child: Gtk.FlowBox search_grid {
                        margin-top: 12;
                        margin-start: 12;
                        margin-end: 12;
                        margin-bottom: 12;
                        column-spacing: 12;
                        row-spacing: 12;
                        min-children-per-line: 3;
                        max-children-per-line: 5;
                        activate-on-single-click: true;
                        selection-mode: none;
                        valign: start;
                      };
                    };
                  };
                }

                /* Favorites: card grid + clear all, or an empty state. */
                Gtk.StackPage {
                name: "favorites";
                child: Gtk.Stack favorites_stack {
                  transition-type: crossfade;
                  transition-duration: 250;

                  Gtk.StackPage {
                    name: "empty";
                    child: Adw.StatusPage {
                      icon-name: "rtv-heart-symbolic";
                      title: _("No favorites yet");
                      description: _("Heart your favorite content to find it here.");
                    };
                  }

                  Gtk.StackPage {
                    name: "grid";
                    child: Gtk.Box {
                      orientation: vertical;

                      Gtk.ScrolledWindow {
                        vexpand: true;
                        hscrollbar-policy: never;

                        child: Adw.Clamp {
                          maximum-size: 1000;

                          child: Gtk.Box favorites_box {
                            orientation: vertical;
                            spacing: 18;
                            margin-top: 12;
                            margin-start: 12;
                            margin-end: 12;
                            margin-bottom: 12;
                          };
                        };
                      }

                      Gtk.Button clear_favorites {
                        label: _("Clear all");
                        halign: center;
                        margin-top: 6;
                        margin-bottom: 12;
                        tooltip-text: _("Remove all favorites");
                        styles ["flat", "dim-label"]
                      }
                    };
                  }
                  };
                }
              };
            };
          };
        };
      }

      /* Full-window player: back button returns to browsing. */
      Adw.NavigationPage player_page {
        title: _("RTV");
        can-pop: true;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar player_headerbar {
            [end]
            Gtk.Button player_heart {
              icon-name: "rtv-heart-symbolic";
              tooltip-text: _("Toggle favorite");
              styles ["flat", "heart-btn"]
            }
          }

          content: Gtk.Box player_content {
            orientation: vertical;
            spacing: 12;
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 12;

            Gtk.Overlay {
              vexpand: true;

              child: Gtk.Box player_box {
                styles ["player"]
                vexpand: true;
              };

              [overlay]
              Gtk.Picture video_surface {
                content-fit: cover;
                visible: false;
              }

              [overlay]
              Gtk.Image app_watermark {
                icon-name: "io.github.tunix.rtv";
                pixel-size: 240;
                halign: center;
                valign: center;
                opacity: 0.15;
              }

              [overlay]
              Gtk.Revealer controls_revealer {
                halign: center;
                valign: end;
                margin-bottom: 12;
                transition-type: crossfade;
                transition-duration: 350;
                reveal-child: true;

                child: Gtk.Box controls {
                  orientation: vertical;
                  spacing: 8;
                  styles ["controls"]

                  Gtk.Box scrub_row {
                    spacing: 8;
                    margin-top: 10;
                    margin-start: 10;
                    margin-end: 10;
                    margin-bottom: 10;
                    valign: center;

                    Gtk.Label elapsed_label {
                      label: "0:00";
                      styles ["caption", "numeric"]
                    }
                    Gtk.Scale seek_scale {
                      orientation: horizontal;
                      hexpand: true;
                      draw-value: false;
                      adjustment: Gtk.Adjustment {
                        lower: 0;
                        upper: 100;
                        value: 0;
                        step-increment: 5;
                        page-increment: 30;
                      };
                    }
                    Gtk.Label duration_label {
                      label: "0:00";
                      styles ["caption", "numeric"]
                    }
                  }

                  Gtk.Box button_row {
                    spacing: 8;
                    margin-start: 14;
                    margin-end: 14;
                    margin-bottom: 10;
                    valign: center;

                    Gtk.Button seek_back {
                      icon-name: "media-seek-backward-symbolic";
                      tooltip-text: _("Back 10 seconds");
                      styles ["flat"]
                    }

                    Gtk.Button play_button_small {
                      icon-name: "media-playback-start-symbolic";
                      tooltip-text: _("Play / Pause");
                      styles ["flat"]
                    }

                    Gtk.Button seek_forward {
                      icon-name: "media-seek-forward-symbolic";
                      tooltip-text: _("Forward 10 seconds");
                      styles ["flat"]
                    }

                    Gtk.Button mute_button {
                      icon-name: "audio-volume-high-symbolic";
                      tooltip-text: _("Mute / Unmute");
                      styles ["flat"]
                    }

                    Gtk.Scale volume_scale {
                      orientation: horizontal;
                      width-request: 100;
                      draw-value: false;
                      valign: center;
                      adjustment: Gtk.Adjustment {
                        lower: 0.0;
                        upper: 1.0;
                        value: 0.7;
                        step-increment: 0.05;
                        page-increment: 0.1;
                      };
                    }

                    Gtk.Button fullscreen_button {
                      icon-name: "view-fullscreen-symbolic";
                      tooltip-text: _("Fullscreen");
                      styles ["flat"]
                    }
                  }
                };
              }
              [overlay]
              Gtk.Label live_badge {
                label: "LIVE";
                halign: end;
                valign: start;
                margin-end: 8;
                margin-top: 8;
                styles ["caption", "dim-label"]
              }
            }

            Gtk.Box content_info_row {
              spacing: 12;

              Gtk.Label content_title {
                styles ["title-3"]
                label: _("Select content");
                halign: start;
                hexpand: true;
                ellipsize: end;
              }

              Gtk.Label content_status {
                styles ["dim-label"]
                label: "—";
                valign: center;
              }
            }
          };
        };
      }

    /* Content details: series or movie body built from Rust. */
      Adw.NavigationPage detail_page {
      title: _("Details");
      can-pop: true;

      child: Adw.ToolbarView {

        [top]
        Adw.HeaderBar {
          [end]
          Gtk.Button detail_heart {
            icon-name: "rtv-heart-symbolic";
            tooltip-text: _("Toggle favorite");
            styles ["flat", "heart-btn"]
          }
        }

        content: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 720;

            child: Gtk.Box detail_content {
              orientation: vertical;
              spacing: 12;
              margin-top: 12;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 24;
            };
          };
        };
      };
      }

      /* Episodes of one season: detail header on top, episodes below. */
      Adw.NavigationPage episodes_page {
      title: _("Episodes");
      can-pop: true;

      child: Adw.ToolbarView {

        [top]
        Adw.HeaderBar {}

        content: Gtk.ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 720;

            child: Gtk.Box episodes_content {
              orientation: vertical;
              spacing: 12;
              margin-top: 12;
              margin-start: 12;
              margin-end: 12;
              margin-bottom: 24;
            };
          };
        };
      };
      }
    };
  };
}

/* The mock-reset item is injected in code on dev builds only (see
 * Window::setup_actions): the release gresource must carry no mock
 * strings. */
menu primary_menu {
  section {
    item {
      label: _("_Settings…");
      action: "win.settings";
    }
    item {
      label: _("_Add source…");
      action: "win.add-source";
    }
  }
  section {
    item {
      label: _("_About RTV");
      action: "win.about";
    }
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
