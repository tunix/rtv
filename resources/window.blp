using Gtk 4.0;
using Adw 1;

template $RtvWindow : Adw.ApplicationWindow {
  title: _("RTV");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 300;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView main_view {

      /* First-run state: no source configured yet — browsing is locked. */
      Adw.NavigationPage welcome_page {
        title: _("RTV");
        can-pop: false;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage {
            icon-name: "io.github.tunix.rtv";
            title: _("Welcome to RTV");
            description: _("Add an IPTV source — an Xtream Codes account or an M3U playlist — to start watching live TV.");

            child: Gtk.Button add_source_button {
              label: _("Add source…");
              action-name: "win.add-source";
              styles ["suggested-action", "pill"]
            };
          };
        };
      }

      /* Main browse state: source picker + nested categories + favorites. */
      Adw.NavigationPage browse_page {
        title: _("RTV");
        can-pop: false;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {
            title-widget: Gtk.Box dropdown_box {
              spacing: 6;
            };

            [end]
            Gtk.MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: Adw.NavigationSplitView {
            min-sidebar-width: 280;

            sidebar: Adw.NavigationPage {
              title: _("Channels");

              child: Gtk.Box {
                orientation: vertical;
                margin-start: 6;
                margin-end: 6;
                margin-bottom: 6;

                Gtk.SearchEntry search_entry {
                  margin-top: 6;
                  margin-start: 6;
                  margin-end: 6;
                  placeholder-text: _("Search channels…");
                }

                Gtk.Label favorites_title {
                  label: _("Favorites");
                  xalign: 0;
                  margin-start: 10;
                  margin-top: 8;
                  visible: false;
                  styles ["caption", "dim-label"]
                }

                Gtk.ListBox favorites_list {
                  styles ["navigation-sidebar"]
                  visible: false;
                }

                Gtk.ScrolledWindow {
                  vexpand: true;
                  hscrollbar-policy: never;

                  child: Gtk.ListBox channel_list {
                    styles ["navigation-sidebar"]

                    Gtk.ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Gtk.Box {
                        spacing: 6;

                        Gtk.Image {
                          icon-name: "chevron-down-symbolic";
                          pixel-size: 14;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Live");
                          xalign: 0;
                          styles ["caption", "dim-label"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "News 24";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "National Geo HD";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Discovery";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Gtk.Box {
                        spacing: 6;

                        Gtk.Image {
                          icon-name: "chevron-down-symbolic";
                          pixel-size: 14;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Sports");
                          xalign: 0;
                          styles ["caption", "dim-label"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Sports HD";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Bein Sports 1";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      activatable: false;
                      selectable: false;

                      child: Gtk.Box {
                        spacing: 6;

                        Gtk.Image {
                          icon-name: "chevron-down-symbolic";
                          pixel-size: 14;
                          valign: center;
                        }

                        Gtk.Label {
                          label: _("Movies");
                          xalign: 0;
                          styles ["caption", "dim-label"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Cinema One";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }

                    Gtk.ListBoxRow {
                      child: Gtk.Box {
                        spacing: 12;
                        margin-start: 26;

                        Gtk.Image {
                          icon-name: "video-display-symbolic";
                          pixel-size: 16;
                          valign: center;
                        }

                        Gtk.Label {
                          label: "Action Movies";
                          halign: start;
                          ellipsize: end;
                        }

                        Gtk.Button {
                          icon-name: "rtv-heart-symbolic";
                          tooltip-text: _("Toggle favorite");
                          valign: center;
                          halign: end;
                          hexpand: true;
                          styles ["flat", "heart-btn"]
                        }
                      };
                    }
                  };
                }
              };
            };

            content: Adw.NavigationPage {
              title: _("RTV");

              child: Adw.StatusPage {
                icon-name: "video-display-symbolic";
                title: _("Nothing selected");
                description: _("Pick a category in the sidebar, then a channel — it opens full-window here.");
              };
            };
          };
        };
      }

      /* Full-window player: back button returns to browsing. */
      Adw.NavigationPage player_page {
        title: _("RTV");
        can-pop: true;

        child: Adw.ToolbarView {

          [top]
          Adw.HeaderBar {
            [end]
            Gtk.Button player_heart {
              icon-name: "rtv-heart-symbolic";
              tooltip-text: _("Toggle favorite");
              styles ["flat", "heart-btn"]
            }
          }

          content: Gtk.Box {
            orientation: vertical;
            spacing: 12;
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 12;

            Gtk.Overlay {
              vexpand: true;

              child: Gtk.Box player_box {
                styles ["player"]
                vexpand: true;
              };

              [overlay]
              Gtk.Button play_button {
                halign: center;
                valign: center;
                styles ["circular", "osd"]

                child: Gtk.Image {
                  pixel-size: 28;
                  icon-name: "media-playback-start-symbolic";
                };
              }

              [overlay]
              Gtk.Label {
                label: "LIVE";
                halign: end;
                valign: end;
                margin-end: 8;
                margin-bottom: 8;
                styles ["caption", "dim-label"]
              }
            }

            Gtk.Box {
              spacing: 12;

              Gtk.Label channel_title {
                styles ["title-3"]
                label: _("Select a channel");
                halign: start;
                hexpand: true;
                ellipsize: end;
              }

              Gtk.Label channel_status {
                styles ["dim-label"]
                label: "—";
                valign: center;
              }
            }
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Add source…");
      action: "win.add-source";
    }
    item {
      label: _("Reset mock state");
      action: "win.reset-mock";
    }
  }
  section {
    item {
      label: _("_About RTV");
      action: "win.about";
    }
    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
